# =============================================================================
# .env.example — Agentic Deployer Configuration
# Copy to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (fake | ollama | openai)
# ---------------------------------------------------------------------------
# 'fake'   → Pattern-matching demo, no API key needed. Default.
# 'ollama' → Local Ollama server (free, Zero Data Retention). Recommended.
# 'openai' → OpenAI API (requires OPENAI_API_KEY).
# 'gemini' → Google Gemini API (requires GEMINI_API_KEY).
# 'groq'   → Groq LPU Inference (requires GROQ_API_KEY).
# 'mistral'→ Mistral AI API (requires MISTRAL_API_KEY).
# 'cohere' → Cohere Command R+ (requires COHERE_API_KEY).
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama Configuration (LLM_PROVIDER=ollama)
# ---------------------------------------------------------------------------
# Run: ollama serve && ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Models with confirmed tool_calls support:
#   qwen2.5:7b      → Best Spanish performance, 8 GB VRAM
#   llama3.1:8b     → Strong reasoning, 8 GB VRAM
#   mistral:7b      → Fast, lighter, 4 GB VRAM

# ---------------------------------------------------------------------------
# OpenAI Configuration (LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1   # or http://localhost:11434/v1 for Ollama compat

# ---------------------------------------------------------------------------
# Google Gemini Configuration (LLM_PROVIDER=gemini)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.1-pro-preview   # Try gemini-3.1-pro-preview or gemini-3.5-flash

# ---------------------------------------------------------------------------
# Groq Configuration (LLM_PROVIDER=groq)
# ---------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant       # Recommended for extremely fast tool use

# ---------------------------------------------------------------------------
# Mistral Configuration (LLM_PROVIDER=mistral)
# ---------------------------------------------------------------------------
# MISTRAL_API_KEY=mstrl_...
# MISTRAL_MODEL=mistral-large-latest    # Excellent for native tool calling

# ---------------------------------------------------------------------------
# Cohere Configuration (LLM_PROVIDER=cohere)
# ---------------------------------------------------------------------------
# COHERE_API_KEY=RKWHk...
# COHERE_MODEL=cohere/command-r-plus-08-2024 # Built for agentic workflows

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
